{
  "name": "kali-mcp-studio",
  "private": true,
  "version": "2.0.0",
  "description": "Kali-MCP Playbook Studio — Vue 3 + TypeScript frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vue-flow/core": "^1.23.0",
    "pinia": "^2.2.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.48.0",
    "typescript": "~5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.0"
  }
}
